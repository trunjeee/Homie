<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RootNamespace>Homie</RootNamespace>
    <AssemblyName>Homie</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\home.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <Platform Condition="'$(Platform)' == '' Or '$(Platform)' == 'AnyCPU'">x64</Platform>
    <RuntimeIdentifier Condition="'$(Platform)' == 'x64'">win-x64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <!-- Обычный .exe без MSIX-упаковки; рантайм Windows App SDK кладётся рядом с exe -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- Нужно, чтобы Homie.pri (скомпилированная разметка XAML) попадал в publish -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <SelfContained>true</SelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>preview</LangVersion>
    <Version>1.0.0</Version>
    <Product>Homie</Product>
    <!-- Папки со сборками лежат внутри проекта — не считаем их исходниками -->
    <DefaultItemExcludes>$(DefaultItemExcludes);publish\**;publish-single\**;publish-backup\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
    <!-- Голос: офлайн-распознавание речи (Vosk) и захват микрофона (NAudio) -->
    <PackageReference Include="Vosk" Version="0.3.38" />
    <PackageReference Include="NAudio.WinMM" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\**" CopyToOutputDirectory="PreserveNewest" />
    <!-- Код навыка Алисы — внутри программы, чтобы скопировать его кнопкой в настройках -->
    <EmbeddedResource Include="alice-skill\index.py" LogicalName="alice-skill/index.py" />
    <EmbeddedResource Include="alice-skill\icon.png" LogicalName="alice-skill/icon.png" />
  </ItemGroup>

</Project>
