<Window
    x:Class="Homie.VoiceWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Homie.Controls"
    Title="Homie — голос">

    <Window.SystemBackdrop>
        <controls:AlwaysActiveAcrylicBackdrop />
    </Window.SystemBackdrop>

    <Grid
        x:Name="Root"
        Padding="16,12,18,12"
        Background="#26000000"
        BorderBrush="#FF464646"
        BorderThickness="1"
        ColumnSpacing="14"
        CornerRadius="14"
        Tapped="Root_Tapped">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Кружок микрофона: внешнее кольцо «дышит» от громкости голоса -->
        <Grid
            Width="56"
            Height="56"
            VerticalAlignment="Center">
            <Ellipse
                x:Name="Ring"
                Width="56"
                Height="56"
                Fill="#33FFFFFF" />
            <Ellipse
                x:Name="Core"
                Width="40"
                Height="40"
                Fill="White" />
            <FontIcon
                x:Name="StateIcon"
                FontSize="17"
                Foreground="Black"
                Glyph="&#xE720;" />
        </Grid>

        <StackPanel
            Grid.Column="1"
            VerticalAlignment="Center"
            Spacing="3">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <Ellipse
                    x:Name="RecDot"
                    Width="7"
                    Height="7"
                    VerticalAlignment="Center"
                    Fill="#FF4D4D" />
                <TextBlock
                    x:Name="StatusText"
                    FontFamily="{StaticResource AppFont}"
                    FontSize="12"
                    Foreground="#99FFFFFF"
                    Text="Слушаю…" />
            </StackPanel>
            <TextBlock
                x:Name="SpeechText"
                FontFamily="{StaticResource AppFontSemiBold}"
                FontSize="17"
                MaxLines="2"
                Text="Говорите"
                TextTrimming="CharacterEllipsis"
                TextWrapping="Wrap" />
            <TextBlock
                x:Name="ResultText"
                FontFamily="{StaticResource AppFont}"
                FontSize="12"
                Foreground="#B3FFFFFF"
                MaxLines="2"
                TextTrimming="CharacterEllipsis"
                TextWrapping="Wrap"
                Visibility="Collapsed" />
        </StackPanel>
    </Grid>
</Window>
