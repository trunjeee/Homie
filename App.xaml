<Application
    x:Class="Homie.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <FontFamily x:Key="AppFont">ms-appx:///Assets/Fonts/Manrope-Medium.ttf#Manrope</FontFamily>
            <FontFamily x:Key="AppFontSemiBold">ms-appx:///Assets/Fonts/Manrope-SemiBold.ttf#Manrope</FontFamily>
            <FontFamily x:Key="ContentControlThemeFontFamily">ms-appx:///Assets/Fonts/Manrope-Medium.ttf#Manrope</FontFamily>

            <!-- Лёгкое стекло для кнопок, плиток и строк: едва заметный фон и тонкая рамка, наведение светлее -->
            <SolidColorBrush x:Key="GlassBrush" Color="#12FFFFFF" />
            <SolidColorBrush x:Key="GlassHoverBrush" Color="#22FFFFFF" />
            <SolidColorBrush x:Key="GlassBorderBrush" Color="#12FFFFFF" />

            <SolidColorBrush x:Key="ButtonBackground" Color="#12FFFFFF" />
            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#22FFFFFF" />
            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#0AFFFFFF" />
            <SolidColorBrush x:Key="ButtonBorderBrush" Color="#12FFFFFF" />
            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#20FFFFFF" />
            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#12FFFFFF" />
            <SolidColorBrush x:Key="ButtonForeground" Color="White" />
            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White" />
            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#D9FFFFFF" />

            <!-- Главные кнопки — белые, как включённые кнопки TouchControl -->
            <SolidColorBrush x:Key="AccentButtonBackground" Color="White" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#FFE8E8E8" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#FFD0D0D0" />
            <SolidColorBrush x:Key="AccentButtonBackgroundDisabled" Color="#33FFFFFF" />
            <SolidColorBrush x:Key="AccentButtonForeground" Color="Black" />
            <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="Black" />
            <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#CC000000" />
            <SolidColorBrush x:Key="AccentButtonForegroundDisabled" Color="#80FFFFFF" />
            <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="Transparent" />
            <SolidColorBrush x:Key="AccentButtonBorderBrushPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="AccentButtonBorderBrushPressed" Color="Transparent" />

            <!-- Переключатели: включено — белый с чёрным кружком -->
            <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="White" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#FFE8E8E8" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#FFD0D0D0" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="Black" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="Black" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="Black" />

            <!-- Ползунок яркости — белый -->
            <SolidColorBrush x:Key="SliderTrackValueFill" Color="White" />
            <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="White" />
            <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#FFE8E8E8" />
            <SolidColorBrush x:Key="SliderThumbBackground" Color="White" />
            <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="White" />
            <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#FFE8E8E8" />
            <SolidColorBrush x:Key="SliderTrackFill" Color="#24FFFFFF" />
            <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="#33FFFFFF" />

            <!-- Всплывающая палитра/яркость — такое же стекло, как панель -->
            <Style x:Key="GlassFlyoutPresenter" TargetType="FlyoutPresenter">
                <Setter Property="Background" Value="#F21C1D1F" />
                <Setter Property="BorderBrush" Value="#1AFFFFFF" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="Padding" Value="16,14" />
            </Style>

            <Style x:Key="TileButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="FontFamily" Value="{StaticResource AppFontSemiBold}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
