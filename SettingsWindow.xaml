<Window
    x:Class="Homie.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:Homie.Services"
    Title="Homie — настройки">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.Resources>
            <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            </Style>
            <Style x:Key="SectionTitle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource AppFontSemiBold}" />
                <Setter Property="FontSize" Value="16" />
            </Style>
            <Style x:Key="Hint" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="#99FFFFFF" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="Card" TargetType="StackPanel">
                <Setter Property="Padding" Value="20" />
                <Setter Property="Spacing" Value="12" />
                <Setter Property="Background" Value="#0DFFFFFF" />
                <Setter Property="BorderBrush" Value="#14FFFFFF" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="14" />
            </Style>
            <!-- Раздел настроек, который сворачивается: заголовок + короткое пояснение -->
            <Style x:Key="CardExpander" TargetType="Expander">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Background" Value="#0DFFFFFF" />
                <Setter Property="BorderBrush" Value="#14FFFFFF" />
                <Setter Property="CornerRadius" Value="14" />
            </Style>
            <Style x:Key="ExpanderHeader" TargetType="StackPanel">
                <Setter Property="Padding" Value="4,12" />
                <Setter Property="Spacing" Value="2" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Padding="16,0,0,0">
            <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="10">
                <Image Width="16" Height="16" Source="ms-appx:///Assets/home.ico" />
                <TextBlock FontSize="12" Foreground="#D9D9D9" Text="Homie — настройки" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" Padding="20,0,20,20">
            <StackPanel Spacing="16">

                <!-- ===== Подключение (раскрыто, только пока не подключено) ===== -->
                <Expander x:Name="ConnectionExpander" Style="{StaticResource CardExpander}">
                    <Expander.Header>
                        <StackPanel Style="{StaticResource ExpanderHeader}">
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Подключение к умному дому" />
                            <TextBlock x:Name="ConnectionHeaderStatus" Style="{StaticResource Hint}" />
                        </StackPanel>
                    </Expander.Header>
                <StackPanel Spacing="12">
                    <TextBlock Style="{StaticResource Hint}">
                        <Run Text="1. Создай приложение на" />
                        <Hyperlink NavigateUri="https://oauth.yandex.ru/client/new">oauth.yandex.ru</Hyperlink>
                        <Run Text="— платформа «Веб-сервисы», Redirect URI https://oauth.yandex.ru/verification_code, права «Умный дом»: просмотр и управление устройствами." />
                        <LineBreak />
                        <Run Text="2. Вставь сюда его ClientID и нажми «Войти через Яндекс»." />
                        <LineBreak />
                        <Run Text="3. Яндекс покажет токен — скопируй его в поле ниже и нажми «Сохранить»." />
                    </TextBlock>

                    <TextBox
                        x:Name="ClientIdBox"
                        Header="ClientID приложения"
                        PlaceholderText="например 0123456789abcdef0123456789abcdef"
                        TextChanged="ClientIdBox_TextChanged" />
                    <Button
                        x:Name="SignInButton"
                        Height="40"
                        HorizontalAlignment="Stretch"
                        Click="SignIn_Click"
                        CornerRadius="12"
                        Style="{StaticResource AccentButtonStyle}">
                        <TextBlock FontFamily="{StaticResource AppFontSemiBold}" Text="Войти через Яндекс" />
                    </Button>

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <PasswordBox
                            x:Name="TokenBox"
                            Header="Токен"
                            PlaceholderText="вставь токен со страницы Яндекса" />
                        <Button
                            Grid.Column="1"
                            Height="32"
                            VerticalAlignment="Bottom"
                            Click="SaveToken_Click"
                            CornerRadius="10"
                            Content="Сохранить" />
                    </Grid>

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Name="StatusText"
                            VerticalAlignment="Center"
                            FontSize="13"
                            TextWrapping="Wrap" />
                        <Button
                            x:Name="SignOutButton"
                            Grid.Column="1"
                            Click="SignOut_Click"
                            CornerRadius="10"
                            Content="Выйти" />
                    </Grid>
                    <TextBlock Style="{StaticResource Hint}" Text="Токен хранится только на этом ПК, зашифрованным (Windows DPAPI). В коде приложения ключей нет." />
                </StackPanel>
                </Expander>

                <!-- ===== Комнаты (раскрыто по умолчанию) ===== -->
                <Expander IsExpanded="True" Style="{StaticResource CardExpander}">
                    <Expander.Header>
                        <StackPanel Style="{StaticResource ExpanderHeader}">
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Комнаты" />
                            <TextBlock Style="{StaticResource Hint}" Text="Порядок в панели и какие комнаты показывать" />
                        </StackPanel>
                    </Expander.Header>
                <StackPanel Spacing="12">
                    <TextBlock Style="{StaticResource Hint}" Text="Порядок в панели сверху вниз. Часто используемые подними наверх, ненужные — скрой." />
                    <StackPanel x:Name="RoomOrderList" Spacing="6" />
                </StackPanel>
                </Expander>

                <!-- ===== Группы (раскрыто по умолчанию) ===== -->
                <Expander IsExpanded="True" Style="{StaticResource CardExpander}">
                    <Expander.Header>
                        <StackPanel Style="{StaticResource ExpanderHeader}">
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Группы" />
                            <TextBlock Style="{StaticResource Hint}" Text="Несколько устройств под одним названием" />
                        </StackPanel>
                    </Expander.Header>
                <StackPanel Spacing="12">
                    <TextBlock Style="{StaticResource Hint}" Text="Несколько устройств под одним названием — одна плитка и одна команда: «Хоуми, выключи люстру». Группа встаёт в комнату своих устройств, сами устройства прячутся внутрь неё." />
                    <StackPanel x:Name="GroupList" Spacing="6" />

                    <TextBox
                        x:Name="GroupNameBox"
                        Header="Новая группа"
                        PlaceholderText="название, например: Люстра" />
                    <ListView
                        x:Name="GroupMembersList"
                        MaxHeight="260"
                        Padding="0"
                        Background="#0DFFFFFF"
                        CornerRadius="10"
                        SelectionMode="Multiple" />
                    <Button
                        HorizontalAlignment="Left"
                        Click="CreateGroup_Click"
                        CornerRadius="10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="12" Glyph="&#xE710;" />
                            <TextBlock Text="Создать группу" />
                        </StackPanel>
                    </Button>
                    <TextBlock
                        x:Name="GroupError"
                        FontSize="12"
                        Foreground="#EF4444"
                        TextWrapping="Wrap" />
                </StackPanel>
                </Expander>

                <!-- ===== Голос ===== -->
                <Expander Style="{StaticResource CardExpander}">
                    <Expander.Header>
                        <StackPanel Style="{StaticResource ExpanderHeader}">
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Голосовое управление" />
                            <TextBlock Style="{StaticResource Hint}" Text="Модель распознавания, «Хоуми» или клавиша, комната этого ПК" />
                        </StackPanel>
                    </Expander.Header>
                <StackPanel Spacing="12">
                    <TextBlock Style="{StaticResource Hint}" Text="Распознавание работает офлайн, прямо на этом ПК — голос никуда не отправляется. Примеры: «Хоуми, выключи свет», «включи свет в зале», «яркость пятьдесят», «сделай ярче», «свет тёплый», «красный свет», «выключи всё везде», «какая температура», «запусти сценарий Ночь»." />

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Spacing="4">
                            <TextBlock
                                x:Name="ModelStatus"
                                FontSize="13"
                                TextWrapping="Wrap" />
                            <ProgressBar
                                x:Name="ModelProgress"
                                Maximum="1"
                                Visibility="Collapsed" />
                        </StackPanel>
                        <Button
                            x:Name="ModelButton"
                            Grid.Column="1"
                            Click="DownloadModel_Click"
                            CornerRadius="10"
                            Content="Скачать" />
                    </Grid>

                    <RadioButtons
                        x:Name="VoiceModeBox"
                        Header="Как слушать"
                        SelectionChanged="VoiceMode_SelectionChanged">
                        <x:String>Выключено</x:String>
                        <x:String>Всегда слушать слово «Хоуми»</x:String>
                        <x:String>Только по клавише</x:String>
                        <x:String>И «Хоуми», и клавиша</x:String>
                    </RadioButtons>

                    <StackPanel x:Name="VoiceKeyPanel" Spacing="4">
                        <TextBox
                            x:Name="VoiceKeyBox"
                            Width="260"
                            HorizontalAlignment="Left"
                            Header="Клавиша для голоса"
                            IsReadOnly="True"
                            PlaceholderText="нажми клавишу или сочетание…"
                            PreviewKeyDown="VoiceKeyBox_PreviewKeyDown" />
                        <TextBlock Style="{StaticResource Hint}" Text="Удерживай — говори, отпусти — выполнится. Короткое нажатие — слушает до паузы. Можно одну клавишу (например F13, Pause, Scroll Lock, Num 0) или сочетание." />
                    </StackPanel>

                    <ComboBox
                        x:Name="PcRoomBox"
                        MinWidth="260"
                        DisplayMemberPath="Name"
                        Header="Комната, где стоит этот ПК"
                        SelectionChanged="PcRoomBox_SelectionChanged" />
                    <TextBlock Style="{StaticResource Hint}" Text="Команды без комнаты («выключи свет») выполняются здесь, как у колонки. «В зале» — в зале, «везде» — во всём доме." />

                    <StackPanel x:Name="WakePanel" Spacing="4">
                        <TextBox
                            x:Name="WakeWordsBox"
                            Header="Как модель слышит «Хоуми» (варианты через запятую)"
                            LostFocus="WakeWordsBox_LostFocus" />
                        <TextBlock
                            x:Name="HeardText"
                            Style="{StaticResource Hint}"
                            Text="Скажи «Хоуми» — здесь появится, что услышал микрофон. Если слово распознаётся иначе, добавь этот вариант в список." />
                    </StackPanel>

                    <TextBlock
                        x:Name="VoiceError"
                        FontSize="12"
                        Foreground="#EF4444"
                        TextWrapping="Wrap" />
                </StackPanel>
                </Expander>

                <!-- ===== Свои голосовые команды ===== -->
                <Expander Style="{StaticResource CardExpander}">
                    <Expander.Header>
                        <StackPanel Style="{StaticResource ExpanderHeader}">
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Голосовые команды для компьютера" />
                            <TextBlock Style="{StaticResource Hint}" Text="Выключить ПК, пауза, громкость, открыть программу…" />
                        </StackPanel>
                    </Expander.Header>
                <StackPanel Spacing="12">
                    <TextBlock Style="{StaticResource Hint}" Text="Одно действие — сколько угодно фраз через запятую. Слова можно говорить в любом падеже и порядке. Выключение и перезагрузка срабатывают через 5 секунд — можно отменить кликом по окошку или «Хоуми, отмена»." />
                    <StackPanel x:Name="ShortcutList" Spacing="8" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Click="AddShortcut_Click" CornerRadius="10">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="12" Glyph="&#xE710;" />
                                <TextBlock Text="Добавить команду" />
                            </StackPanel>
                        </Button>
                        <Button
                            Background="Transparent"
                            BorderThickness="0"
                            Click="ResetShortcuts_Click"
                            CornerRadius="10"
                            Content="Вернуть стандартные" />
                    </StackPanel>
                </StackPanel>
                </Expander>

                <!-- ===== Ответы голосом ===== -->
                <Expander Style="{StaticResource CardExpander}">
                    <Expander.Header>
                        <StackPanel Style="{StaticResource ExpanderHeader}">
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Ответы голосом" />
                            <TextBlock Style="{StaticResource Hint}" Text="Записанные фразы на каждое событие, громкость" />
                        </StackPanel>
                    </Expander.Header>
                <StackPanel Spacing="12">
                    <Grid>
                        <TextBlock VerticalAlignment="Center" FontSize="13" Text="Отвечать голосом" />
                        <ToggleSwitch
                            x:Name="RepliesToggle"
                            MinWidth="0"
                            HorizontalAlignment="Right"
                            OffContent=""
                            OnContent=""
                            Toggled="RepliesToggle_Toggled" />
                    </Grid>
                    <TextBlock Style="{StaticResource Hint}" Text="Заранее записанные фразы (mp3, wav, ogg) — например из Fish Audio. На одно событие можно добавить несколько файлов, Homie выберет случайный. Файлы копируются к Homie, оригиналы можно удалить." />
                    <Slider
                        x:Name="ReplyVolume"
                        Header="Громкость ответов"
                        Maximum="100"
                        Minimum="0"
                        ValueChanged="ReplyVolume_ValueChanged" />
                    <StackPanel x:Name="ReplyList" Spacing="6" />
                    <Button
                        HorizontalAlignment="Left"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="ResetReplies_Click"
                        CornerRadius="10"
                        Content="Вернуть стандартные ответы" />
                </StackPanel>
                </Expander>

                <!-- ===== Нейросеть ===== -->
                <Expander Style="{StaticResource CardExpander}">
                    <Expander.Header>
                        <StackPanel Style="{StaticResource ExpanderHeader}">
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Нейросеть — ответы на вопросы" />
                            <TextBlock Style="{StaticResource Hint}" Text="OpenRouter: ключ, модели, голос ответа" />
                        </StackPanel>
                    </Expander.Header>
                <StackPanel Spacing="12">
                    <Grid>
                        <TextBlock VerticalAlignment="Center" FontSize="13" Text="Отвечать на вопросы" />
                        <ToggleSwitch
                            x:Name="AiToggle"
                            MinWidth="0"
                            HorizontalAlignment="Right"
                            OffContent=""
                            OnContent=""
                            Toggled="AiToggle_Toggled" />
                    </Grid>
                    <TextBlock Style="{StaticResource Hint}">
                        <Run Text="Если фраза — не команда («Хоуми, сколько до Луны?»), Homie спросит нейросеть через OpenRouter и ответит голосом. Бесплатные модели (с «:free») — до 50 вопросов в день. Ключ создаётся на" />
                        <Hyperlink NavigateUri="https://openrouter.ai/settings/keys">openrouter.ai/settings/keys</Hyperlink>
                        <Run Text="— он хранится только на этом ПК, зашифрованным." />
                    </TextBlock>

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <PasswordBox
                            x:Name="AiKeyBox"
                            Header="Ключ OpenRouter"
                            PlaceholderText="sk-or-v1-…" />
                        <Button
                            Grid.Column="1"
                            Height="32"
                            VerticalAlignment="Bottom"
                            Click="SaveAiKey_Click"
                            CornerRadius="10"
                            Content="Сохранить" />
                        <Button
                            x:Name="DeleteAiKeyButton"
                            Grid.Column="2"
                            Height="32"
                            VerticalAlignment="Bottom"
                            Click="DeleteAiKey_Click"
                            CornerRadius="10"
                            Content="Удалить" />
                    </Grid>
                    <TextBlock x:Name="AiKeyStatus" FontSize="13" />

                    <TextBox
                        x:Name="AiModelBox"
                        Header="Модель"
                        LostFocus="AiModel_LostFocus" />
                    <TextBox
                        x:Name="AiFallbackBox"
                        Header="Запасные модели через запятую (если основная занята)"
                        LostFocus="AiModel_LostFocus" />
                    <TextBlock Style="{StaticResource Hint}">
                        <Run Text="Список бесплатных моделей:" />
                        <Hyperlink NavigateUri="https://openrouter.ai/models?max_price=0">openrouter.ai/models?max_price=0</Hyperlink>
                        <Run Text="— копируй название вместе с «:free»." />
                    </TextBlock>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ToggleSwitch
                            x:Name="AiSpeakToggle"
                            Header="Озвучивать ответ (нужен интернет)"
                            OffContent="Только текст"
                            OnContent="Голосом"
                            Toggled="AiSpeak_Toggled" />
                        <ComboBox
                            x:Name="AiVoiceBox"
                            Grid.Column="1"
                            MinWidth="160"
                            VerticalAlignment="Bottom"
                            Header="Голос"
                            SelectionChanged="AiVoice_SelectionChanged">
                            <x:String>Светлана</x:String>
                            <x:String>Дмитрий</x:String>
                        </ComboBox>
                    </Grid>

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="AiTestBox" PlaceholderText="вопрос для проверки, например: привет, как дела?" />
                        <Button
                            x:Name="AiTestButton"
                            Grid.Column="1"
                            Click="AiTest_Click"
                            CornerRadius="10"
                            Content="Спросить" />
                    </Grid>
                    <TextBlock
                        x:Name="AiTestResult"
                        FontSize="13"
                        TextWrapping="Wrap" />
                </StackPanel>
                </Expander>

                <!-- ===== Сообщения от Алисы ===== -->
                <Expander Style="{StaticResource CardExpander}">
                    <Expander.Header>
                        <StackPanel Style="{StaticResource ExpanderHeader}">
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Сообщения от Алисы" />
                            <TextBlock
                                x:Name="RelayHeaderStatus"
                                Style="{StaticResource Hint}"
                                Text="«Алиса, попроси помощника Хоуми передать: ужин готов» — и этот ПК скажет это голосом" />
                        </StackPanel>
                    </Expander.Header>

                    <StackPanel Spacing="12">
                        <Grid>
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="13"
                                Text="Принимать сообщения" />
                            <ToggleSwitch
                                x:Name="RelayToggle"
                                MinWidth="0"
                                HorizontalAlignment="Right"
                                OffContent=""
                                OnContent=""
                                Toggled="RelayToggle_Toggled" />
                        </Grid>

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                x:Name="RelayKeyBox"
                                FontFamily="Consolas"
                                Header="Ключ связи"
                                IsReadOnly="True" />
                            <Button
                                Grid.Column="1"
                                Height="32"
                                VerticalAlignment="Bottom"
                                Click="CopyRelayKey_Click"
                                CornerRadius="10"
                                Content="Скопировать" />
                            <Button
                                Grid.Column="2"
                                Height="32"
                                VerticalAlignment="Bottom"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="NewRelayKey_Click"
                                CornerRadius="10"
                                Content="Новый ключ" />
                        </Grid>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button
                                Click="CopySkillCode_Click"
                                CornerRadius="10"
                                Content="Скопировать код навыка" />
                            <Button
                                Click="SaveSkillIcon_Click"
                                CornerRadius="10"
                                Content="Сохранить иконку" />
                            <Button
                                x:Name="RelayTestButton"
                                Click="RelayTest_Click"
                                CornerRadius="10"
                                Content="Проверить" />
                        </StackPanel>
                        <TextBlock
                            x:Name="RelayStatus"
                            FontSize="13"
                            TextWrapping="Wrap" />

                        <!-- Инструкция — тоже свёрнута. Сверено с интерфейсом Яндекса (сентябрь 2026). -->
                        <Expander
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Background="Transparent"
                            BorderThickness="0"
                            Header="Как настроить навык (один раз, минут 10)">
                            <StackPanel Spacing="10">
                                <TextBlock
                                    FontSize="13"
                                    LineHeight="21"
                                    TextWrapping="Wrap">
                                    <Run FontFamily="{StaticResource AppFontSemiBold}" Text="Сначала функция в облаке, потом навык — навыку нужно выбрать готовую функцию." />
                                    <LineBreak />
                                    <LineBreak />
                                    <Run FontFamily="{StaticResource AppFontSemiBold}" Text="1. Включи «Принимать сообщения»" />
                                    <Run Text="выше — появится «Ключ связи»." />
                                    <LineBreak />
                                    <Run FontFamily="{StaticResource AppFontSemiBold}" Text="2. Функция." />
                                    <Run Text="Открой" />
                                    <Hyperlink NavigateUri="https://console.yandex.cloud/">console.yandex.cloud</Hyperlink>
                                    <Run Text="→ Cloud Functions (первый раз облако попросит завести платёжный аккаунт — функции для навыков Алисы не тарифицируются) → «Создать функцию» → Имя: homie → «Создать»." />
                                    <LineBreak />
                                    <Run FontFamily="{StaticResource AppFontSemiBold}" Text="3. Код." />
                                    <Run Text="Во вкладке «Редактор» выбери Python (3.12 или новее) → «Продолжить». В файле index.py удали пример и вставь код — кнопка «Скопировать код навыка». Точка входа: index.handler." />
                                    <LineBreak />
                                    <Run FontFamily="{StaticResource AppFontSemiBold}" Text="4. Параметры." />
                                    <Run Text="Таймаут — 5 секунд (по умолчанию 3 — мало). Память 128 МБ, сервисный аккаунт и сеть не нужны. «Переменные окружения»: Ключ — HOMIE_KEY, Значение — «Ключ связи» (кнопка «Скопировать»). Нажми «Сохранить изменения» внизу." />
                                    <LineBreak />
                                    <Run FontFamily="{StaticResource AppFontSemiBold}" Text="5. Проверка функции (необязательно)." />
                                    <Run Text="Вкладка «Тестирование» → вставь тестовый запрос (кнопка ниже) → «Запустить тест». Этот ПК скажет «Тебе передали: привет от функции»." />
                                    <LineBreak />
                                    <Run FontFamily="{StaticResource AppFontSemiBold}" Text="6. Навык." />
                                    <Run Text="Открой" />
                                    <Hyperlink NavigateUri="https://dialogs.yandex.ru/developer">dialogs.yandex.ru/developer</Hyperlink>
                                    <Run Text="(тот же Яндекс ID, что на колонках) → «Создать диалог» → «Навык». Заполни: Название — минимум два слова, например «Помощник Хоуми»; Активационные имена (тоже от двух слов) — формы названия: «помощника Хоуми», «помощнику Хоуми»; Описание — любое; Backend — «Функция в Яндекс Облаке» → homie; Тип доступа — «Приватный» (модерация не нужна); Категория — любая; Имя разработчика — любое; Иконка — кнопка «Сохранить иконку». Хранилище, сайт, AppMetrica и RTB не трогай." />
                                    <LineBreak />
                                    <Run FontFamily="{StaticResource AppFontSemiBold}" Text="7. Публикация." />
                                    <Run Text="«Сохранить», затем «Опубликовать»." />
                                    <LineBreak />
                                    <Run FontFamily="{StaticResource AppFontSemiBold}" Text="8. Готово." />
                                    <Run Text="Колонке: «Алиса, попроси помощника Хоуми передать: привет». Если Алиса плохо слышит «Хоуми», добавь активационное имя «помощник Хоми»." />
                                </TextBlock>
                                <Button
                                    HorizontalAlignment="Left"
                                    Click="CopyTestRequest_Click"
                                    CornerRadius="10"
                                    Content="Скопировать тестовый запрос" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </Expander>

                <!-- ===== Горячие клавиши ===== -->
                <Expander Style="{StaticResource CardExpander}">
                    <Expander.Header>
                        <StackPanel Style="{StaticResource ExpanderHeader}">
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Горячие клавиши" />
                            <TextBlock Style="{StaticResource Hint}" Text="Сочетания клавиш для сценариев и устройств" />
                        </StackPanel>
                    </Expander.Header>
                <StackPanel Spacing="12">
                    <TextBlock Style="{StaticResource Hint}" Text="Работают из любой программы, даже из игры. Нужна хотя бы одна клавиша-модификатор: Ctrl, Alt, Shift или Win." />

                    <ItemsControl x:Name="HotkeyList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="6" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="services:HotkeyBinding">
                                <Grid
                                    Padding="12,6,6,6"
                                    Background="#0DFFFFFF"
                                    ColumnSpacing="12"
                                    CornerRadius="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border
                                        Padding="8,3"
                                        VerticalAlignment="Center"
                                        Background="#24FFFFFF"
                                        CornerRadius="6">
                                        <TextBlock
                                            FontFamily="{StaticResource AppFontSemiBold}"
                                            FontSize="12"
                                            Text="{x:Bind services:HotkeyText.Format(Modifiers, Key)}" />
                                    </Border>
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        Text="{x:Bind services:HotkeyText.Describe(Target, TargetName)}"
                                        TextTrimming="CharacterEllipsis" />
                                    <Button
                                        Grid.Column="2"
                                        Width="32"
                                        Height="32"
                                        Padding="0"
                                        AutomationProperties.Name="Удалить"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Click="RemoveHotkey_Click"
                                        CornerRadius="8"
                                        Tag="{x:Bind}">
                                        <FontIcon FontSize="12" Glyph="&#xE74D;" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Grid ColumnSpacing="8" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            x:Name="HotkeyBox"
                            Header="Сочетание"
                            IsReadOnly="True"
                            PlaceholderText="нажми клавиши…"
                            PreviewKeyDown="HotkeyBox_PreviewKeyDown" />
                        <ComboBox
                            x:Name="TargetBox"
                            Grid.Column="1"
                            HorizontalAlignment="Stretch"
                            DisplayMemberPath="Title"
                            Header="Что делать"
                            PlaceholderText="сценарий или устройство" />
                        <Button
                            Grid.Column="2"
                            Height="32"
                            VerticalAlignment="Bottom"
                            Click="AddHotkey_Click"
                            CornerRadius="10"
                            Content="Добавить" />
                    </Grid>
                    <TextBlock x:Name="HotkeyError" Foreground="#EF4444" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
