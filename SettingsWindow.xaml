<Window
    x:Class="Homie.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:Homie.Services"
    Title="Homie — настройки">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.Resources>
            <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            </Style>
            <Style x:Key="SectionTitle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource AppFontSemiBold}" />
                <Setter Property="FontSize" Value="16" />
            </Style>
            <Style x:Key="Hint" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="#99FFFFFF" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="Card" TargetType="StackPanel">
                <Setter Property="Padding" Value="20" />
                <Setter Property="Spacing" Value="12" />
                <Setter Property="Background" Value="#0DFFFFFF" />
                <Setter Property="BorderBrush" Value="#14FFFFFF" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="14" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Padding="16,0,0,0">
            <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="10">
                <Image Width="16" Height="16" Source="ms-appx:///Assets/home.ico" />
                <TextBlock FontSize="12" Foreground="#D9D9D9" Text="Homie — настройки" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" Padding="20,0,20,20">
            <StackPanel Spacing="16">

                <!-- ===== Подключение ===== -->
                <StackPanel Style="{StaticResource Card}">
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Подключение к умному дому" />
                    <TextBlock Style="{StaticResource Hint}">
                        <Run Text="1. Создай приложение на" />
                        <Hyperlink NavigateUri="https://oauth.yandex.ru/client/new">oauth.yandex.ru</Hyperlink>
                        <Run Text="— платформа «Веб-сервисы», Redirect URI https://oauth.yandex.ru/verification_code, права «Умный дом»: просмотр и управление устройствами." />
                        <LineBreak />
                        <Run Text="2. Вставь сюда его ClientID и нажми «Войти через Яндекс»." />
                        <LineBreak />
                        <Run Text="3. Яндекс покажет токен — скопируй его в поле ниже и нажми «Сохранить»." />
                    </TextBlock>

                    <TextBox
                        x:Name="ClientIdBox"
                        Header="ClientID приложения"
                        PlaceholderText="например 0123456789abcdef0123456789abcdef"
                        TextChanged="ClientIdBox_TextChanged" />
                    <Button
                        x:Name="SignInButton"
                        Height="40"
                        HorizontalAlignment="Stretch"
                        Click="SignIn_Click"
                        CornerRadius="12"
                        Style="{StaticResource AccentButtonStyle}">
                        <TextBlock FontFamily="{StaticResource AppFontSemiBold}" Text="Войти через Яндекс" />
                    </Button>

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <PasswordBox
                            x:Name="TokenBox"
                            Header="Токен"
                            PlaceholderText="вставь токен со страницы Яндекса" />
                        <Button
                            Grid.Column="1"
                            Height="32"
                            VerticalAlignment="Bottom"
                            Click="SaveToken_Click"
                            CornerRadius="10"
                            Content="Сохранить" />
                    </Grid>

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Name="StatusText"
                            VerticalAlignment="Center"
                            FontSize="13"
                            TextWrapping="Wrap" />
                        <Button
                            x:Name="SignOutButton"
                            Grid.Column="1"
                            Click="SignOut_Click"
                            CornerRadius="10"
                            Content="Выйти" />
                    </Grid>
                    <TextBlock Style="{StaticResource Hint}" Text="Токен хранится только на этом ПК, зашифрованным (Windows DPAPI). В коде приложения ключей нет." />
                </StackPanel>

                <!-- ===== Комнаты ===== -->
                <StackPanel Style="{StaticResource Card}">
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Комнаты" />
                    <TextBlock Style="{StaticResource Hint}" Text="Порядок в панели сверху вниз. Часто используемые подними наверх, ненужные — скрой." />
                    <StackPanel x:Name="RoomOrderList" Spacing="6" />
                </StackPanel>

                <!-- ===== Голос ===== -->
                <StackPanel Style="{StaticResource Card}">
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Голосовое управление" />
                    <TextBlock Style="{StaticResource Hint}" Text="Распознавание работает офлайн, прямо на этом ПК — голос никуда не отправляется. Примеры: «Хоуми, выключи свет», «включи свет в зале», «яркость пятьдесят», «сделай ярче», «свет тёплый», «красный свет», «выключи всё везде», «какая температура», «запусти сценарий Ночь»." />

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Spacing="4">
                            <TextBlock
                                x:Name="ModelStatus"
                                FontSize="13"
                                TextWrapping="Wrap" />
                            <ProgressBar
                                x:Name="ModelProgress"
                                Maximum="1"
                                Visibility="Collapsed" />
                        </StackPanel>
                        <Button
                            x:Name="ModelButton"
                            Grid.Column="1"
                            Click="DownloadModel_Click"
                            CornerRadius="10"
                            Content="Скачать" />
                    </Grid>

                    <RadioButtons
                        x:Name="VoiceModeBox"
                        Header="Как слушать"
                        SelectionChanged="VoiceMode_SelectionChanged">
                        <x:String>Выключено</x:String>
                        <x:String>Всегда слушать слово «Хоуми»</x:String>
                        <x:String>Только по клавише</x:String>
                        <x:String>И «Хоуми», и клавиша</x:String>
                    </RadioButtons>

                    <StackPanel x:Name="VoiceKeyPanel" Spacing="4">
                        <TextBox
                            x:Name="VoiceKeyBox"
                            Width="260"
                            HorizontalAlignment="Left"
                            Header="Клавиша для голоса"
                            IsReadOnly="True"
                            PlaceholderText="нажми клавишу или сочетание…"
                            PreviewKeyDown="VoiceKeyBox_PreviewKeyDown" />
                        <TextBlock Style="{StaticResource Hint}" Text="Удерживай — говори, отпусти — выполнится. Короткое нажатие — слушает до паузы. Можно одну клавишу (например F13, Pause, Scroll Lock, Num 0) или сочетание." />
                    </StackPanel>

                    <ComboBox
                        x:Name="PcRoomBox"
                        MinWidth="260"
                        DisplayMemberPath="Name"
                        Header="Комната, где стоит этот ПК"
                        SelectionChanged="PcRoomBox_SelectionChanged" />
                    <TextBlock Style="{StaticResource Hint}" Text="Команды без комнаты («выключи свет») выполняются здесь, как у колонки. «В зале» — в зале, «везде» — во всём доме." />

                    <StackPanel x:Name="WakePanel" Spacing="4">
                        <TextBox
                            x:Name="WakeWordsBox"
                            Header="Как модель слышит «Хоуми» (варианты через запятую)"
                            LostFocus="WakeWordsBox_LostFocus" />
                        <TextBlock
                            x:Name="HeardText"
                            Style="{StaticResource Hint}"
                            Text="Скажи «Хоуми» — здесь появится, что услышал микрофон. Если слово распознаётся иначе, добавь этот вариант в список." />
                    </StackPanel>

                    <TextBlock
                        x:Name="VoiceError"
                        FontSize="12"
                        Foreground="#EF4444"
                        TextWrapping="Wrap" />
                </StackPanel>

                <!-- ===== Свои голосовые команды ===== -->
                <StackPanel Style="{StaticResource Card}">
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Голосовые команды для компьютера" />
                    <TextBlock Style="{StaticResource Hint}" Text="Одно действие — сколько угодно фраз через запятую. Слова можно говорить в любом падеже и порядке. Выключение и перезагрузка срабатывают через 5 секунд — можно отменить кликом по окошку или «Хоуми, отмена»." />
                    <StackPanel x:Name="ShortcutList" Spacing="8" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Click="AddShortcut_Click" CornerRadius="10">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="12" Glyph="&#xE710;" />
                                <TextBlock Text="Добавить команду" />
                            </StackPanel>
                        </Button>
                        <Button
                            Background="Transparent"
                            BorderThickness="0"
                            Click="ResetShortcuts_Click"
                            CornerRadius="10"
                            Content="Вернуть стандартные" />
                    </StackPanel>
                </StackPanel>

                <!-- ===== Ответы голосом ===== -->
                <StackPanel Style="{StaticResource Card}">
                    <Grid>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Ответы голосом" />
                        <ToggleSwitch
                            x:Name="RepliesToggle"
                            MinWidth="0"
                            HorizontalAlignment="Right"
                            OffContent=""
                            OnContent=""
                            Toggled="RepliesToggle_Toggled" />
                    </Grid>
                    <TextBlock Style="{StaticResource Hint}" Text="Заранее записанные фразы (mp3, wav, ogg) — например из Fish Audio. На одно событие можно добавить несколько файлов, Homie выберет случайный. Файлы копируются к Homie, оригиналы можно удалить." />
                    <Slider
                        x:Name="ReplyVolume"
                        Header="Громкость ответов"
                        Maximum="100"
                        Minimum="0"
                        ValueChanged="ReplyVolume_ValueChanged" />
                    <StackPanel x:Name="ReplyList" Spacing="6" />
                </StackPanel>

                <!-- ===== Горячие клавиши ===== -->
                <StackPanel Style="{StaticResource Card}">
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Горячие клавиши" />
                    <TextBlock Style="{StaticResource Hint}" Text="Работают из любой программы, даже из игры. Нужна хотя бы одна клавиша-модификатор: Ctrl, Alt, Shift или Win." />

                    <ItemsControl x:Name="HotkeyList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="6" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="services:HotkeyBinding">
                                <Grid
                                    Padding="12,6,6,6"
                                    Background="#0DFFFFFF"
                                    ColumnSpacing="12"
                                    CornerRadius="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border
                                        Padding="8,3"
                                        VerticalAlignment="Center"
                                        Background="#24FFFFFF"
                                        CornerRadius="6">
                                        <TextBlock
                                            FontFamily="{StaticResource AppFontSemiBold}"
                                            FontSize="12"
                                            Text="{x:Bind services:HotkeyText.Format(Modifiers, Key)}" />
                                    </Border>
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        Text="{x:Bind services:HotkeyText.Describe(Target, TargetName)}"
                                        TextTrimming="CharacterEllipsis" />
                                    <Button
                                        Grid.Column="2"
                                        Width="32"
                                        Height="32"
                                        Padding="0"
                                        AutomationProperties.Name="Удалить"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Click="RemoveHotkey_Click"
                                        CornerRadius="8"
                                        Tag="{x:Bind}">
                                        <FontIcon FontSize="12" Glyph="&#xE74D;" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Grid ColumnSpacing="8" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            x:Name="HotkeyBox"
                            Header="Сочетание"
                            IsReadOnly="True"
                            PlaceholderText="нажми клавиши…"
                            PreviewKeyDown="HotkeyBox_PreviewKeyDown" />
                        <ComboBox
                            x:Name="TargetBox"
                            Grid.Column="1"
                            HorizontalAlignment="Stretch"
                            DisplayMemberPath="Title"
                            Header="Что делать"
                            PlaceholderText="сценарий или устройство" />
                        <Button
                            Grid.Column="2"
                            Height="32"
                            VerticalAlignment="Bottom"
                            Click="AddHotkey_Click"
                            CornerRadius="10"
                            Content="Добавить" />
                    </Grid>
                    <TextBlock x:Name="HotkeyError" Foreground="#EF4444" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
