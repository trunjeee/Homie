<Window
    x:Class="Homie.FlyoutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Homie.Controls"
    xmlns:services="using:Homie.Services"
    xmlns:vm="using:Homie.ViewModels"
    Title="Homie">

    <Window.SystemBackdrop>
        <controls:AlwaysActiveAcrylicBackdrop />
    </Window.SystemBackdrop>

    <Grid
        x:Name="Root"
        Background="#26000000"
        BorderBrush="#FF464646"
        BorderThickness="1"
        CornerRadius="14"
        KeyDown="Root_KeyDown">
        <Grid.Resources>
            <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="SectionTitle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource AppFontSemiBold}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="#B3FFFFFF" />
                <Setter Property="Margin" Value="0,0,0,8" />
            </Style>
            <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Width" Value="36" />
                <Setter Property="Height" Value="36" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== Шапка ===== -->
        <Grid Padding="20,16,14,8" ColumnSpacing="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock FontFamily="{StaticResource AppFontSemiBold}" FontSize="18" Text="Homie" />
                <ComboBox
                    MinWidth="120"
                    VerticalAlignment="Center"
                    DisplayMemberPath="Name"
                    ItemsSource="{x:Bind Home.Households}"
                    SelectedItem="{x:Bind Home.SelectedHousehold, Mode=OneWay}"
                    SelectionChanged="Household_SelectionChanged"
                    Visibility="{x:Bind Home.HasMultipleHouseholds, Mode=OneWay}" />
                <ProgressRing
                    Width="16"
                    Height="16"
                    IsActive="{x:Bind Home.IsLoading, Mode=OneWay}" />
            </StackPanel>
            <Button
                Grid.Column="1"
                AutomationProperties.Name="Обновить"
                Click="Refresh_Click"
                Style="{StaticResource IconButton}"
                ToolTipService.ToolTip="Обновить">
                <FontIcon FontSize="14" Glyph="&#xE72C;" />
            </Button>
            <Button
                Grid.Column="2"
                AutomationProperties.Name="Настройки"
                Click="Settings_Click"
                Style="{StaticResource IconButton}"
                ToolTipService.ToolTip="Настройки">
                <FontIcon FontSize="14" Glyph="&#xE713;" />
            </Button>
        </Grid>

        <!-- ===== Не подключено ===== -->
        <StackPanel
            Grid.Row="1"
            Padding="24"
            VerticalAlignment="Center"
            Spacing="12"
            Visibility="{x:Bind NotSignedIn(Home.IsSignedIn), Mode=OneWay}">
            <FontIcon HorizontalAlignment="Center" FontSize="32" Glyph="&#xE80F;" />
            <TextBlock
                HorizontalAlignment="Center"
                FontFamily="{StaticResource AppFontSemiBold}"
                FontSize="16"
                Text="Подключи умный дом" />
            <TextBlock
                HorizontalAlignment="Center"
                FontSize="12"
                Foreground="#99FFFFFF"
                Text="{x:Bind SignInHint(Home.ErrorText), Mode=OneWay}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
            <Button
                Height="44"
                HorizontalAlignment="Stretch"
                Click="Settings_Click"
                CornerRadius="14"
                Style="{StaticResource AccentButtonStyle}">
                <TextBlock FontFamily="{StaticResource AppFontSemiBold}" Text="Открыть настройки" />
            </Button>
        </StackPanel>

        <!-- ===== Сценарии и устройства ===== -->
        <ScrollViewer
            Grid.Row="1"
            Padding="20,4,20,20"
            Visibility="{x:Bind Home.IsSignedIn, Mode=OneWay}">
            <StackPanel Spacing="18">
                <TextBlock
                    FontSize="12"
                    Foreground="#EF4444"
                    Text="{x:Bind Home.ErrorText, Mode=OneWay}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind HasText(Home.ErrorText), Mode=OneWay}" />

                <StackPanel Visibility="{x:Bind HasItems(Home.Scenarios.Count), Mode=OneWay}">
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Сценарии" />
                    <ItemsControl ItemsSource="{x:Bind Home.Scenarios}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid
                                    ItemHeight="52"
                                    ItemWidth="112"
                                    MaximumRowsOrColumns="3"
                                    Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="services:Scenario">
                                <Button
                                    Margin="0,0,6,6"
                                    VerticalAlignment="Stretch"
                                    Click="Scenario_Click"
                                    Style="{StaticResource TileButtonStyle}"
                                    Tag="{x:Bind}">
                                    <TextBlock
                                        FontFamily="{StaticResource AppFontSemiBold}"
                                        FontSize="12"
                                        Text="{x:Bind Name}"
                                        TextAlignment="Center"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="Wrap" />
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <ItemsControl ItemsSource="{x:Bind Home.Rooms}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="18" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:RoomGroup">
                            <StackPanel>
                                <TextBlock
                                    Margin="0,0,0,8"
                                    FontFamily="{StaticResource AppFontSemiBold}"
                                    FontSize="13"
                                    Foreground="#B3FFFFFF"
                                    Text="{x:Bind Name}" />
                                <ItemsControl ItemsSource="{x:Bind Devices}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Spacing="6" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:DeviceItem">
                                            <Grid
                                                Padding="14,10,10,10"
                                                Background="#99212426"
                                                BorderBrush="#FF434446"
                                                BorderThickness="1"
                                                ColumnSpacing="12"
                                                CornerRadius="14"
                                                RowSpacing="2">
                                                <Grid.Resources>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
                                                        <Setter Property="VerticalAlignment" Value="Center" />
                                                    </Style>
                                                </Grid.Resources>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <FontIcon FontSize="18" Glyph="{x:Bind Glyph}" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock
                                                        FontFamily="{StaticResource AppFontSemiBold}"
                                                        FontSize="13"
                                                        Text="{x:Bind Name}"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <TextBlock
                                                        FontSize="11"
                                                        Foreground="#99FFFFFF"
                                                        Text="{x:Bind Subtitle, Mode=OneWay}"
                                                        TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <ToggleSwitch
                                                    Grid.Column="2"
                                                    MinWidth="0"
                                                    IsOn="{x:Bind IsOn, Mode=TwoWay}"
                                                    OffContent=""
                                                    OnContent=""
                                                    Visibility="{x:Bind HasOnOff}" />
                                                <Slider
                                                    Grid.Row="1"
                                                    Grid.Column="1"
                                                    Grid.ColumnSpan="2"
                                                    Margin="0,0,8,0"
                                                    Maximum="100"
                                                    Minimum="1"
                                                    Value="{x:Bind Brightness, Mode=TwoWay}"
                                                    Visibility="{x:Bind HasBrightness}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
